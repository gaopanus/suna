# .env.production.example
# Copy this file to .env.production and fill in your production values.
# These variables are embedded into the frontend bundle during the build process.
# Make sure these are safe to be publicly visible.

# General App Info
VITE_APP_NAME="Suna Vue"
VITE_APP_VERSION=1.0.0

# API Configuration
# Base URL for your deployed FastAPI backend
VITE_API_BASE_URL=https://your-production-api.example.com/api
# Note: If your backend is served on the same domain but different path (e.g. /api),
# and you use a reverse proxy in front of Vite and FastAPI, this could be relative, like /api.
# Otherwise, it should be the full absolute URL.

# Supabase Configuration (Production Project)
VITE_SUPABASE_URL=https://your-prod-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-supabase-anon-key

# Optional: Sentry for error tracking in production
VITE_SENTRY_DSN=""

# Optional: Langfuse for LLM observability in production
VITE_LANGFUSE_PUBLIC_KEY=""
VITE_LANGFUSE_HOST_URL="https://cloud.langfuse.com" # Or your self-hosted instance

# Optional: Other public keys or configuration
# VITE_SOME_OTHER_PUBLIC_KEY="your-public-key"
# VITE_FEATURE_FLAG_XYZ="true"
# VITE_RECAPTCHA_SITE_KEY=""

# --- IMPORTANT ---
# DO NOT commit your actual .env.production file with real secrets/keys to version control.
# Add .env.production to your .gitignore file.
# This example file is safe to commit.
# During your build process (e.g., in CI/CD), ensure the .env.production file
# is created with the correct values or that these environment variables are
# set directly in the build environment. Vite will pick them up.
# For example, Vercel, Netlify, GitHub Actions allow setting environment variables
# that will be available during the build.
# --- --- --- --- ---
